# 飞书 ↔ Cursor Agent Bridge（cursor-remote）
# 复制为 secrets/feishu_cursor_bridge.env 并填写真值（该文件不入 git）

# 飞书开放平台 → 企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 可选：首次启动后通过配对码绑定，会自动写入 ~/.cursor-remote/config.env
# ALLOWED_USER_IDS=

# Cursor Agent CLI 鉴权（二选一）
# 1) 在本机终端执行一次: agent login
# 2) 或在此填写 API Key: https://cursor.com/dashboard → Settings → API Keys
# CURSOR_API_KEY=

# Agent 模型（Free 套餐必须 auto；Pro/Ultra 可改 composer-2.5 等）
CURSOR_AGENT_MODEL=composer-2.5
