# 飞书 Codex Bridge：复制为同目录 feishu_codex_bridge.env 后填写。
# setup.ps1 将已支持的字段写入 ~/.feishu-codex-bridge/config.env。
# 修改此文件的实值副本后，重新运行 setup.ps1 并重启 bridge。

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 允许使用的飞书 open_id，多个用逗号分隔；为空时启动后先在私聊完成配对。
# 注意：当前代码在白名单为空时不会阻断全部普通任务，详见 README。
ALLOWED_USER_IDS=

# 建议填写实际任务项目的绝对路径；留空时 setup 使用仓库根目录。
DEFAULT_PROJECT_PATH=
# 分号分隔，例如：项目A=E:/work/project-a;项目B=E:/work/project-b
CODEX_PROJECTS=
CODEX_PROJECT_DISCOVERY=thread-list
CODEX_PROJECT_DISCOVERY_TIMEOUT=15000
CODEX_PROJECT_DISCOVERY_INTERVAL=60000

CODEX_BIN=codex
CODEX_TASK_TRANSPORT=desktop
CODEX_MODEL=
CODEX_MODEL_CHOICES=
CODEX_REASONING_EFFORT=
CODEX_REASONING_EFFORT_CHOICES=low,medium,high,xhigh,max,ultra
CODEX_PROFILE=
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_DANGEROUS_BYPASS=0
CODEX_FULL_AUTO=0
CODEX_CONFIG_OVERRIDES=
CODEX_ENABLE_WEB_SEARCH=0

GENERATED_IMAGE_MAX_COUNT=4
STREAM_PUSH_INTERVAL=30000
TASK_TIMEOUT=1200000
LOG_LEVEL=info

# CODEX_HOME、SESSION_STATE_PATH、CODEX_APP_TOOLS_PIPE_PATH、CODEX_DESKTOP_IPC_PATH
# 不会由 setup 从此文件复制；请设置到启动环境，或 setup 后补入运行配置。
