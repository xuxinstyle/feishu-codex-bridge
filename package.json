{
  "name": "feishu-codex-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Feishu bot bridge for running local Codex CLI tasks.",
  "scripts": {
    "start": "node bridge.mjs",
    "check": "node --check bridge.mjs",
    "test": "node --test test/*.test.mjs",
    "preview:cards": "node scripts/preview-cards.mjs --serve",
    "test:live": "node scripts/verify-task-resume.mjs",
    "test:history:live": "node scripts/verify-history.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
